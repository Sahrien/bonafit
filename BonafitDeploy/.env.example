# OVH VPS deploy (rsync over SSH). Copy to .env and fill in.
SSH_HOST=217.182.61.45
SSH_PORT=22
SSH_USER=deploy
# Absolute path, ~, or relative to BonafitDeploy/
SSH_PRIVATE_KEY=~/.ssh/id_ed25519_ovh

# Prod remotes. --dev maps /srv/bonafit -> /srv/dev.bonafit automatically.
REMOTE_WEB=/srv/bonafit/public
REMOTE_FRONTEND=/srv/bonafit/app
REMOTE_BACKEND=/srv/bonafit/api

API_UNIT=bonafit-api-bonafit
API_UNIT_DEV=bonafit-api-bonafit_dev
APP_USER=bonafit
