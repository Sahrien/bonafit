FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_TLS=false
FTP_USER=prod-user
FTP_PASSWORD=
FTP_USER_DEV=dev-user
FTP_PASSWORD_DEV=
FTP_REMOTE_FRONTEND=/public_html/app
FTP_REMOTE_BACKEND=/opt/bonafit-api
FTP_REMOTE_WEB=/public_html

# Optional; default to the FTP host/user/password for the selected environment
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_USER_DEV=
SSH_PASSWORD_DEV=
# Relative paths are resolved from BonafitDeploy/
SSH_PRIVATE_KEY=id_rsa
